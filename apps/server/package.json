{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "stats:import": "tsx --env-file-if-exists=../../.env src/scripts/import-stats.ts",
    "games:import": "tsx --env-file-if-exists=../../.env src/scripts/import-games.ts",
    "stats:export-seed": "tsx --env-file-if-exists=../../.env src/scripts/export-seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@libsql/client": "^0.15.0",
    "@tabiya/core": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "ts-fsrs": "^6.0.0",
    "tsx": "^4.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
