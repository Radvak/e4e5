# Public URL of the app (used for the Lichess OAuth redirect). In dev: the Vite server.
PUBLIC_URL=http://localhost:5173
PORT=3000
DATABASE_URL=file:./data/tabiya.db
# Long random string: openssl rand -hex 32
COOKIE_SECRET=change-me
# "Continue as guest" login without Lichess (default: true in dev, false in production)
# GUEST_LOGIN=true
# Optional: your own Lichess token (https://lichess.org/account/oauth/token, no scope needed),
# used for statistics of users who have not linked a Lichess account (e.g. Chess.com players).
# LICHESS_APP_TOKEN=
# Android app (Trusted Web Activity, tools/android): SHA-256 fingerprints of the signing keys,
# comma-separated (upload key, and Play App Signing key from the Play Console), for
# /.well-known/assetlinks.json. In production: fly secrets set ANDROID_SHA256_FINGERPRINTS=...
# ANDROID_PACKAGE=dev.fly.tabiya.twa
# ANDROID_SHA256_FINGERPRINTS=
